# SSHWarden 配置文件示例
# 将此文件复制为 config.toml 并根据需要修改

# ============================================
# 服务器配置
# ============================================
[server]
# Bitwarden 服务器基础 URL
# 默认: "https://vault.bitwarden.com"
# 自托管服务器示例: "https://your-bitwarden-server.com"
base_url = "https://vault.bitwarden.com"

# API URL（可选，默认为 base_url/api）
# api_url = "https://vault.bitwarden.com/api"

# Identity URL（可选，默认为 base_url/identity）
# identity_url = "https://vault.bitwarden.com/identity"

# Notification URL（可选）
# 如果不设置：
#   - vault.bitwarden.com -> https://notifications.bitwarden.com
#   - vault.bitwarden.eu  -> https://notifications.bitwarden.eu
#   - 其它自托管地址       -> {base_url}/notifications
# 可填写 notifications base，也可填写完整 hub URL：
# notifications_url = "https://your-bitwarden-server.com/notifications"
# notifications_url = "wss://your-bitwarden-server.com/notifications/hub"

# ============================================
# 认证配置
# ============================================
[auth]
# 认证方法
# 可选值: "password", "api_key"
# 默认: "password"
method = "password"

# Bitwarden 账户邮箱
# 留空则每次启动时提示输入
email = ""

# ============================================
# Agent 配置
# ============================================
[agent]
# SSH 签名请求提示行为
# 可选值:
#   - "always": 每次请求都提示（最安全）
#   - "never": 从不提示（自动批准所有请求）
#   - "remember_until_lock": 记住决定直到锁定（平衡安全与便利）
# 默认: "always"
prompt_behavior = "always"

# 通知降级同步间隔（秒）
# WebSocket 通知正常时不会盲目轮询；当通知连接断开并重连失败后，
# 最多按此间隔执行一次 fallback sync。设置为 0 可禁用 fallback sync。
# 默认: 300（5 分钟）
sync_interval = 300

# Notification Hub keepalive 间隔（秒）
# 默认: 30
notification_keepalive_interval = 30

# Notification Hub 空闲超时（秒）
# 超过该时间未收到任何消息/echo/ping/pong 则重连。
# 默认: 90
notification_idle_timeout = 90

# 触发 fallback sync 前允许的连续重连失败次数
# 默认: 3
notification_reconnect_attempts_before_fallback = 3

# Notification Hub 重连最大退避时间（秒）
# 默认: 60
notification_reconnect_max_backoff = 60

# 自动锁定超时（秒）
# 无活动后自动锁定 Agent
# 默认: 3600（1 小时）
# 设置为 0 禁用自动锁定
lock_timeout = 3600

# ============================================
# 解锁配置
# ============================================
[unlock]
# 默认解锁方法
# 可选值:
#   - "windows_hello": Windows Hello 生物识别（仅 Windows）
#   - "pin": PIN 码快速解锁
#   - "password": Bitwarden 主密码
# 默认: Windows 上为 "windows_hello"，其他平台为 "password"
method = "windows_hello"

# 备用解锁方法
# 当主解锁方法失败时使用
# 可选值:
#   - "pin": PIN 码
#   - "password": 主密码
# 默认: "pin"
fallback = "pin"

# SSH 请求时自动尝试解锁
# true: 收到 SSH 请求时自动尝试 Windows Hello 解锁
# false: 需要手动解锁
# 默认: true
auto_unlock_on_request = true

# ============================================
# 存储配置
# ============================================
[storage]
# 默认使用平台标准用户目录：
#   Windows: %APPDATA%\SSHWarden
#   Linux:   $XDG_CONFIG_HOME/sshwarden 或 ~/.config/sshwarden
#   macOS:   ~/Library/Application Support/SSHWarden
# 便携模式是显式选择；也可用 SSHWARDEN_PORTABLE=1 或 SSHWARDEN_HOME 覆盖。
portable = false
# portable_dir = "./sshwarden-data"

# ============================================
# Socket 配置（高级）
# ============================================
[socket]
# 自定义 agent endpoint 路径（可选）
# Windows 默认: \\.\pipe\openssh-ssh-agent
# Linux 默认:   $XDG_RUNTIME_DIR/sshwarden/agent.sock（无 XDG_RUNTIME_DIR 时使用临时目录）
# macOS 默认:   临时 runtime 目录中的 sshwarden/agent.sock
# path = "\\\\.\\pipe\\openssh-ssh-agent"
# path = "/run/user/1000/sshwarden/agent.sock"
